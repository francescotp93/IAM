# ═══════════════════════════════════════════════════════════════════════════
#  iam.withusassicurazioni.it — UN SOLO INDIRIZZO (dal 15/09/2026)
#
#  Questo file vive nel repository (QUOTE/deploy/caddy/) e l'autopull lo copia
#  in /etc/caddy/withus/, da dove il Caddyfile lo importa. Si modifica QUI, mai
#  a mano sul server: al giro successivo l'autopull lo valida, lo ricarica e, se
#  non e' valido, rimette quello di prima (vedi deploy/autopull.sh).
#
#  Tre cose sotto lo stesso nome:
#    1. /nuovo-preventivo/…  → QUOTO, i file statici gia' in /opt/withus-backend
#    2. /api, /moto, /pay, …  → il backend sulla stessa macchina (porta 3000)
#    3. tutto il resto        → IAM, i file statici in /opt/withus-backend/iam
#       (dal 16/09/2026 IAM e' la cartella iam/ del repository unico: si
#       aggiorna con lo stesso pull del backend, niente secondo clone)
#
#  Stessa origine per IAM e per il preventivatore nel riquadro: il browser
#  condivide il login da solo, i token smettono di viaggiare nell'indirizzo, e
#  i clic dentro il riquadro tornano visibili alla scocca (INTERFACCIA-QUOTO-IAM
#  §2, INDIRIZZO-UNICO.md in Agente-sospesi).
#
#  Il blocco api.withusassicurazioni.it NON sta qui e non si tocca: e' scritto
#  a mano nel Caddyfile, con il suo registro (deploy/REGISTRO-RICHIESTE.md).
#
#  Finche' il DNS di iam. punta a GitHub Pages questo blocco non riceve
#  traffico e Caddy non riesce a farsi dare il certificato: riprova da solo,
#  e ci riesce nei minuti successivi al cambio DNS. Non e' un errore.
# ═══════════════════════════════════════════════════════════════════════════
iam.withusassicurazioni.it {
	encode gzip zstd

	# ── 1. QUOTO sotto /nuovo-preventivo/ ──────────────────────────────────
	# /nuovo-preventivo senza barra: si aggiunge, altrimenti i percorsi
	# relativi della pagina (tariffe/motore/…) cercherebbero alla radice.
	redir /nuovo-preventivo /nuovo-preventivo/ 308

	handle_path /nuovo-preventivo/* {
		root * /opt/withus-backend

		# QUOTE e' un monorepo: alla radice stanno anche il backend, gli
		# scraper e la configurazione. GitHub Pages li esponeva tutti (solo
		# .env era 404). Qui restano fuori. ATTENZIONE: /tariffe/motore/*.js e
		# /tariffe/*.json li carica il BROWSER (i motori di tariffa e i premi):
		# NON vanno nascosti, e la prova deploy/dominio-unico.test.mjs lo
		# controlla.
		@sorgente_quoto {
			path /server/* /scraper/* /supabase/* /deploy/* /config/* /node_modules/*
			path /.git/* /.github/* /.claude/* /withus-one/verifica/*
			path /.env /.env.* /package.json /package-lock.json /static-server.js /CNAME
			path *.mjs *.md *.py *.sh *.sql *.service *.timer
			# IAM ha la sua porta, la radice: sotto /nuovo-preventivo/iam/ non serve
			path /iam/*
		}
		respond @sorgente_quoto 404

		# Chi puo' incorniciare il preventivatore: solo questa origine, cioe'
		# IAM. Su GitHub Pages questa regola non si poteva scrivere (niente
		# header di risposta) e stava dentro la pagina, sul referrer
		# (index.html, primo <script>): quella guardia resta come seconda
		# rete, ma la prima e' questa, che il browser applica prima di
		# eseguire una riga di codice (INTERFACCIA-QUOTO-IAM §2.3).
		header Content-Security-Policy "frame-ancestors 'self'"
		header X-Frame-Options SAMEORIGIN

		# ── LA CACHE DELL'APPLICAZIONE (18/09/2026) ────────────────────
		# QUOTO e IAM sono due `index.html` da un paio di megabyte: tutto il
		# programma sta lì dentro. Senza dire niente sulla cache, il browser
		# applica la sua euristica e si tiene la pagina per ore — e chi la ha
		# in memoria continua a usare il codice del rilascio prima senza
		# saperlo. Il 18/09/2026 è costato un'ora: dopo il rilascio della
		# gestione documentale, le schermate nuove non comparivano e i
		# documenti non si aprivano, perché la pagina in cache non aveva la
		# parte che firma gli indirizzi. Il VPS serviva il codice giusto; era
		# il browser a non chiederlo.
		#
		# `no-cache` NON vuol dire «non mettere in cache»: vuol dire
		# «richiedi conferma prima di usarla». Col confronto dell'etichetta
		# (`ETag`, che Caddy manda da sé) la risposta è quasi sempre un 304
		# vuoto, quindi si paga un viaggio di rete e non due megabyte. Vale
		# solo per le pagine: i motori di tariffa, le immagini e i fogli di
		# stile restano in cache come prima, perché hanno la versione
		# nell'indirizzo (`?v=20260918`).
		@pagine path *.html /
		header @pagine Cache-Control "no-cache"

		file_server
	}

	# ── 2. I percorsi di servizio del backend ──────────────────────────────
	# L'elenco e' quello di Agente-sospesi/vercel.json (28/07/2026), preso
	# dalle rotte dichiarate in server/*.js. Oggi il preventivatore chiama il
	# backend con l'indirizzo assoluto api.withusassicurazioni.it (PAY_API):
	# queste righe servono a poterlo chiamare anche con percorsi relativi,
	# dallo stesso indirizzo, senza CORS.
	@servizi path /api/* /auth/* /backup/* /catalogo/* /crm/* /diag/* /firma-collab/* /fonti /fonti/* /health /l/* /lead/* /login/* /mail/* /marketing/* /moto/* /notify/* /pay/* /preventivi/* /products/* /public/* /scrape/* /shop/* /sign/* /user/*
	handle @servizi {
		reverse_proxy localhost:3000
	}

	# ── 3. IAM alla radice ─────────────────────────────────────────────────
	handle {
		root * /opt/withus-backend/iam

		# Prove, migrazioni, documenti interni e la configurazione di Vercel
		# non sono pagine: fuori (deploy/TRASLOCO-OVH.md).
		@sorgente_iam {
			path /verifica/* /sql/* /docs/* /compliance/* /.git/* /.github/* /.claude/*
			path /package.json /controlla-tutto.mjs /vercel.json /CNAME /.gitignore /.nojekyll
			path *.mjs *.md
		}
		respond @sorgente_iam 404

		# Stessa ragione del riquadro qui sopra: la scocca di IAM è un
		# `index.html` solo, e una copia vecchia in cache è un'applicazione
		# vecchia.
		@pagine_iam path *.html /
		header @pagine_iam Cache-Control "no-cache"

		file_server
	}
}
